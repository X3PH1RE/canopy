{
  "name": "@canopy/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --config vite.config.mjs --configLoader native",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && vite build --config vite.config.mjs --configLoader native",
    "test": "vitest --run --config ../../vitest.config.mjs --configLoader native --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@canopy/shared": "workspace:*",
    "@fontsource/dm-sans": "5.1.0",
    "@fontsource/fraunces": "5.1.0",
    "zustand": "5.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "@types/node": "20.17.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "^5.6.3",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  }
}
